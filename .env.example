# getproperty-liff — every environment variable this app reads (validated with zod in src/lib/env.ts; the server
# refuses to start with an invalid value). Copy to .env.local for local work. Every value is read at RUN time on the
# server (D-230: one image for every environment — collective-infra promotes the UAT image to production); the
# NEXT_PUBLIC_* ones are public by definition and reach the browser through the server-rendered <html data-*>
# attributes or page props, never through the bundle. On the platform they all come from the secret
# collective/<env>/getproperty/liff (→ /run/collective/getproperty-liff.env). The one build-time switch is
# NEXT_PUBLIC_LIFF_MOCK (the mock build flavour).

# ── LIFF (src/lib/liff) ─────────────────────────────────────────────────────────────────────
# The LIFF app id from the LINE Developers console (Collective Group's LINE Login channel). The LIFF endpoint URL
# registered there is https://<this host>/liff. "Open in LINE" links use https://liff.line.me/<id>/<path>.
# Required in production (without it a non-mock server fails its start-up check and answers 500, health included). The SDK gets it from <html data-liff-id>.
# NEXT_PUBLIC_LIFF_ID=1234567890-AbCdEfGh
# The LINE Official Account id (validated; no screen links it today — building chats come from the API's contacts).
# NEXT_PUBLIC_LINE_OA_ID=@getproperty

# 1 = use the in-memory fake LIFF instead of the SDK (tests, `pnpm dev:mock`). The build flavour, inlined at build
# time: a platform build never sets it (`pnpm release:hygiene` fails if the fake or the mock API is in the bundle).
# NEXT_PUBLIC_LIFF_MOCK=1

# The owner console of getproperty-web: the landlord's quick actions (/landlord) link there for heavier work.
# OWNER_CONSOLE_URL=https://app.getproperty.co

# ── Backend (getproperty-api) ───────────────────────────────────────────────────────────────
# Server-to-server only (BFF, server components, the proxy's token renewal). Required in production.
# API_INTERNAL_URL=http://localhost:3000
# Only `pnpm gen:api --adopt` reads it (default: the sibling checkout).
# API_CONTRACT_SOURCE=../getproperty-api/contract/openapi.json
# 1 = answer the API from the contract mocks in mocks/ (only in a NEXT_PUBLIC_LIFF_MOCK=1 build).
# API_MOCKS=1
# Public origin of this app, for the BFF's same-origin check when a proxy rewrites Host. Caddy (the Collective
# platform's one proxy, D-230) keeps Host, so production may leave it unset.
# APP_ORIGIN=https://liff.getproperty.co
# Proxies in front of this app that append to X-Forwarded-For. The platform's Caddy replaces an internet client's
# header with that client's address: production = 1 (set by collective-infra's docker-compose). The BFF sends the
# API only the entry this many from the right (the address our edge saw); 0 = none (local dev). Review H2, D-229.
# TRUSTED_HOPS=1
# Who may read /api/metrics (Grafana Alloy). Default: loopback + private ranges (the platform's docker network).
# METRICS_ALLOWED_CIDRS=172.30.0.0/16,127.0.0.0/8

# ── Feature flags (read at request time) ────────────────────────────────────────────────────
# 1 = the technicians' "my work orders" at /technician and the /v1/technician BFF prefixes (R2, L4).
# FEATURE_TECHNICIAN=1

# ── Assets, push ────────────────────────────────────────────────────────────────────────────
# Object storage serving signed images and receiving presigned uploads (added to the CSP): the product's S3 bucket
# (D-230). Read at run time by the proxy.
# NEXT_PUBLIC_ASSET_BASE_URL=https://collective-uat-getproperty-assets.s3.ap-southeast-7.amazonaws.com
# VAPID application server key for web push (offered after the first payment, L2); passed to the page as a prop.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ── Observability ───────────────────────────────────────────────────────────────────────────
# Server and browser error reporting (scrubbed: no cookies, bodies, query strings or users).
# Google / Apple outside LINE for prospects and residents (D-255, D-283). OAUTH_MODE: live (production default) shows a
# button only when its client is set; fake (default elsewhere) opens a local test page instead of the provider.
# Redirect URI to register with Google / Apple: <APP_ORIGIN>/bff/oauth/<google|apple>/callback
# OAUTH_MODE=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# APPLE_SERVICES_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# FIREBASE_WEB_API_KEY=
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=uat
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# Browser error reporting; the browser reads it from <html data-sentry-dsn>.
# NEXT_PUBLIC_SENTRY_DSN=
# OpenTelemetry: server fetch spans (incl. calls to the API, with trace context) to this OTLP/HTTP collector.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=getproperty-liff
# "dev" / "uat" badge in the top bar and the browser's Sentry environment; empty (or "production") in production.
# NEXT_PUBLIC_ENV_BADGE=uat

# ── Integration project (pnpm e2e:integration) ─────────────────────────────────────────────
# GETPROPERTY_API_DIR=../getproperty-api
# INTEGRATION_API_PORT=4610
# INTEGRATION_PORT=3600
