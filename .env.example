# getproperty-liff — every environment variable this app reads. Copy to .env.local for local work.
# Anything NEXT_PUBLIC_* is compiled into the browser bundle at build time and is public by definition.

# ── LIFF (src/lib/liff) ─────────────────────────────────────────────────────────────────────
# The LIFF app id from the LINE Developers console (Collective Group's LINE Login channel). The LIFF
# endpoint URL registered there is https://<this host>/liff.
# NEXT_PUBLIC_LIFF_ID=1234567890-AbCdEfGh
# The LINE Official Account id, for "chat with the building" links (L1).
# NEXT_PUBLIC_LINE_OA_ID=@getproperty

# 1 = use the in-memory fake LIFF instead of the SDK (tests, `pnpm dev:mock`). Inlined at build time:
# a production build must never set it (`pnpm release:hygiene` fails if the fake is in the bundle).
# NEXT_PUBLIC_LIFF_MOCK=1

# ── Feature flags (src/lib/flags.ts; read at request time) ──────────────────────────────────
# 1 = show the technicians' "my work orders" at /technician (R2, L4).
# FEATURE_TECHNICIAN=1

# ── Backend (getproperty-api) — L1 ──────────────────────────────────────────────────────────
# Server-to-server only. Browser code calls this app's own /bff/* (/v1/resident/*, /v1/technician/*).
# API_INTERNAL_URL=http://localhost:4000
# API_CONTRACT_SOURCE=../getproperty-api/contract/openapi.json

# ── Observability (L1) ──────────────────────────────────────────────────────────────────────
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_ENV_BADGE=uat
