# getproperty-liff — every environment variable this app reads (validated with zod in src/lib/env.ts; the server
# refuses to start with an invalid value). Copy to .env.local for local work. Anything NEXT_PUBLIC_* is compiled
# into the browser bundle at build time and is public by definition.

# ── LIFF (src/lib/liff) ─────────────────────────────────────────────────────────────────────
# The LIFF app id from the LINE Developers console (Collective Group's LINE Login channel). The LIFF endpoint URL
# registered there is https://<this host>/liff. "Open in LINE" links use https://liff.line.me/<id>/<path>.
# NEXT_PUBLIC_LIFF_ID=1234567890-AbCdEfGh
# The LINE Official Account id, for "chat with the building" links.
# NEXT_PUBLIC_LINE_OA_ID=@getproperty

# 1 = use the in-memory fake LIFF instead of the SDK (tests, `pnpm dev:mock`). Inlined at build time: a production
# build must never set it (`pnpm release:hygiene` fails if the fake or the mock API is in the bundle).
# NEXT_PUBLIC_LIFF_MOCK=1

# ── Backend (getproperty-api) ───────────────────────────────────────────────────────────────
# Server-to-server only (BFF, server components, the proxy's token renewal). Required in production.
# API_INTERNAL_URL=http://localhost:3000
# Only `pnpm gen:api --adopt` reads it (default: the sibling checkout).
# API_CONTRACT_SOURCE=../getproperty-api/contract/openapi.json
# 1 = answer the API from the contract mocks in mocks/ (only in a NEXT_PUBLIC_LIFF_MOCK=1 build).
# API_MOCKS=1
# Public origin of this app, for the BFF's same-origin check when a proxy rewrites Host (Cloud Run behind a LB).
# APP_ORIGIN=https://liff.getproperty.co

# ── Feature flags (read at request time) ────────────────────────────────────────────────────
# 1 = the technicians' "my work orders" at /technician and the /v1/technician BFF prefixes (R2, L4).
# FEATURE_TECHNICIAN=1

# ── Assets, push ────────────────────────────────────────────────────────────────────────────
# Object storage serving signed images and receiving presigned uploads (added to the CSP).
# NEXT_PUBLIC_ASSET_BASE_URL=https://storage.googleapis.com
# VAPID application server key for web push (offered after the first payment, L2).
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ── Observability ───────────────────────────────────────────────────────────────────────────
# Server and browser error reporting (scrubbed: no cookies, bodies, query strings or users).
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=uat
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# NEXT_PUBLIC_SENTRY_DSN=
# OpenTelemetry: server fetch spans (incl. calls to the API, with trace context) to this OTLP/HTTP collector.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=getproperty-liff
# "dev" / "uat" badge in the top bar; empty in production.
# NEXT_PUBLIC_ENV_BADGE=uat

# ── Integration project (pnpm e2e:integration) ─────────────────────────────────────────────
# GETPROPERTY_API_DIR=../getproperty-api
# INTEGRATION_API_PORT=4610
# INTEGRATION_PORT=3600
