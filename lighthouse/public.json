{
  "extends": "./shared.json",
  "$comment": "Signed-out pages (LIFF entry, sign-in, SMS code, signed out): same device, network and budgets as resident.json, no session.",
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3400/liff",
        "http://localhost:3400/auth",
        "http://localhost:3400/auth/otp",
        "http://localhost:3400/signed-out"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 360,
          "height": 780,
          "deviceScaleFactor": 2.625,
          "disabled": false
        },
        "throttlingMethod": "simulate",
        "throttling": {
          "rttMs": 150,
          "throughputKbps": 1638.4,
          "cpuSlowdownMultiplier": 4
        }
      }
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 2000
          }
        ],
        "cumulative-layout-shift": [
          "warn",
          {
            "maxNumericValue": 0.05
          }
        ],
        "resource-summary:script:size": [
          "error",
          {
            "maxNumericValue": 184320
          }
        ]
      }
    }
  }
}
