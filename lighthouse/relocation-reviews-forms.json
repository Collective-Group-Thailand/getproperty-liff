{
  "extends": "./shared.json",
  "$comment": "GL4 forms (D-299, D-301): relocation help while off (the consent text and its box, loaded near the screen) and the review form (rating, text, the review.publish text, its box) on a mock account whose tenure is verified. Same device, network and budgets as resident.json.",
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3400/relocation",
        "http://localhost:3400/lease/26454f8e-e2db-4262-8b9d-587a3f75b9d4/review"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 360,
          "height": 780,
          "deviceScaleFactor": 2.625,
          "disabled": false
        },
        "throttlingMethod": "simulate",
        "throttling": {
          "rttMs": 150,
          "throughputKbps": 1638.4,
          "cpuSlowdownMultiplier": 4
        },
        "extraHeaders": {
          "Cookie": "__Host-gp_rt=mock-rt.seed.Ulighthouse-reviewer"
        }
      }
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 2000
          }
        ],
        "cumulative-layout-shift": [
          "warn",
          {
            "maxNumericValue": 0.05
          }
        ],
        "resource-summary:script:size": [
          "error",
          {
            "maxNumericValue": 184320
          }
        ]
      }
    }
  }
}
