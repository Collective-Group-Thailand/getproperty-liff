{
  "extends": "./shared.json",
  "$comment": "Resident LIFF pages on a mid-range Android over 4G inside LINE: LCP ≤ 2.0 s, CLS ≤ 0.05, initial JS ≤ 150 KB gz (docs/performance-budgets.md). Measured as a 360×780 phone with the Lighthouse mobile preset, LIFF mocked (NEXT_PUBLIC_LIFF_MOCK=1). L2 adds invoices/[id], pay, receipts; L3 usage, lease.",
  "ci": {
    "collect": {
      "url": ["http://localhost:3400/", "http://localhost:3400/liff"],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 360,
          "height": 780,
          "deviceScaleFactor": 2.625,
          "disabled": false
        },
        "throttlingMethod": "simulate",
        "throttling": { "rttMs": 150, "throughputKbps": 1638.4, "cpuSlowdownMultiplier": 4 }
      }
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": ["warn", { "maxNumericValue": 2000 }],
        "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.05 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 153600 }]
      }
    }
  }
}
