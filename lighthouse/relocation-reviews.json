{
  "extends": "./shared.json",
  "$comment": "GL4 relocation and reviews (D-299, D-301): relocation help with an open offer (destination Ari, listings there), the offer page (destination form and enquiry sheet load near / on demand), the review page with my published review and the lease page with its relocation and review entries, on a mock account under notice with relocation help on and a published review. Same device, network and budgets as resident.json.",
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3400/relocation",
        "http://localhost:3400/relocation/900b8262-7d7d-4add-8f46-1f0d1cdff0a1",
        "http://localhost:3400/lease/900b8262-7d7d-4add-8f46-1f0d1cdf0a38/review",
        "http://localhost:3400/lease/900b8262-7d7d-4add-8f46-1f0d1cdf0a38"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 360,
          "height": 780,
          "deviceScaleFactor": 2.625,
          "disabled": false
        },
        "throttlingMethod": "simulate",
        "throttling": {
          "rttMs": 150,
          "throughputKbps": 1638.4,
          "cpuSlowdownMultiplier": 4
        },
        "extraHeaders": {
          "Cookie": "__Host-gp_rt=mock-rt.seed.Ulighthouse-relocating-moveout-reviewed"
        }
      }
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 2000
          }
        ],
        "cumulative-layout-shift": [
          "warn",
          {
            "maxNumericValue": 0.05
          }
        ],
        "resource-summary:script:size": [
          "error",
          {
            "maxNumericValue": 184320
          }
        ]
      }
    }
  }
}
